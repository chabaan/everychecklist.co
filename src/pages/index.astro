---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { siteConfig } from "../config/site";

const allArticles = await getCollection("articles");
allArticles.sort((a, b) => {
  const ai = siteConfig.categoryOrder.indexOf(a.data.category);
  const bi = siteConfig.categoryOrder.indexOf(b.data.category);
  return (ai === -1 ? 999 : ai) - (bi === -1 ? 999 : bi);
});

const seenCats = new Map();
for (const a of allArticles) {
  if (!seenCats.has(a.data.category)) seenCats.set(a.data.category, a.slug);
}
const navPairs = [...seenCats.entries()];
---
<Base title={`${siteConfig.name} — Printable Checklists for Every Stage of Life`} description={siteConfig.defaultDescription} canonicalPath="/">
  <Fragment slot="nav">
    {navPairs.map(([cat, slug]) => (<li><a href={`/articles/${slug}/`}>{cat}</a></li>))}
  </Fragment>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">Every list you'll ever need</span>
        <h1>Plan life, one <em>checkbox</em> at a time.</h1>
        <p class="hero-sub">{siteConfig.tagline}. Free to read. Free to print.</p>
        <div class="hero-actions"><a href="#featured" class="btn btn-primary">Browse checklists</a></div>
      </div>
      <div class="hero-list" aria-hidden="true">
        <div class="hero-list-title">Today's to-do</div>
        {allArticles.slice(0, 4).map((a) => (<div class="tick-row"><span class="tick-box"></span><span>{a.data.title}</span></div>))}
      </div>
    </div>
  </section>
  <section class="section" id="featured">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Featured</span><h2>Checklists to start with</h2></div>
      <div class="card-grid">
        {allArticles.map((a) => (
          <a class="card" href={`/articles/${a.slug}/`}>
            <img class="card-img" src={`/images/hero/${a.slug}.svg`} alt="" loading="lazy" width="800" height="500" />
            <div class="card-body">
              <span class="chip">{a.data.category}</span>
              <h3>{a.data.title}</h3>
              <p>{a.data.dek}</p>
              <div class="card-meta"><span>{a.data.sections.reduce((n, s) => n + s.items.length, 0)} items</span><span>{a.data.readTime} min read</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">Browse by category</span><h2>Find your category</h2></div>
      <div class="chip-row">{navPairs.map(([cat, slug]) => (<a class="chip" href={`/articles/${slug}/`}>{cat}</a>))}</div>
    </div>
  </section>
</Base>
